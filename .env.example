# Documentation template. Export values in each process; copying this file alone does not load it.
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/homeit_dev
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
NODE_ENV=development
# API process: PORT=3001
# Frontend process: PORT=5173 and BASE_PATH=/

# Comma-separated frontend origins for cross-origin API use; empty means same-origin only.
CORS_ORIGINS=http://localhost:5173
# Local demo seed only; never reuse production credentials.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
